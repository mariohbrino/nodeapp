<div class="bg-gray-800 w-full max-w-4xl mx-auto p-6 rounded-2xl">
  {{#if post}}
    {{> post-card post=post}}
  {{else}}
    <p class="text-gray-400">Post not found.</p>
  {{/if}}
  <div class="flex justify-end mt-4">
    <a href="/posts" class="bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-500">Back to Posts</a>
  </div>
</div>
