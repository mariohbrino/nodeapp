<div class="bg-gray-800 w-full max-w-4xl mx-auto p-6 rounded-2xl">
  <h1 class="text-2xl font-bold mb-4">{{title}}</h1>
  <form action="/posts/{{post.id}}/update" method="POST" class="flex flex-col gap-4">
    <div class="flex flex-col gap-2">
      <label for="title" class="text-white font-semibold">Title</label>
      <input type="text" name="title" id="title" class="p-2 rounded-lg bg-white text-black" value="{{post.title}}" required />
    </div>
    <div class="flex flex-col gap-2">
      <label for="content" class="text-white font-semibold">Content</label>
      <textarea name="content" id="content" rows="5" class="p-2 rounded-lg bg-white text-black" required>{{post.content}}</textarea>
    </div>
    <button type="submit" class="bg-blue-500 text-white py-2 px-4 rounded-lg hover:bg-blue-600 transition-colors">Update Post</button>
  </form>
  <div class="flex justify-end mt-4">
    <a href="/posts" class="bg-gray-600 text-white px-4 py-2 rounded hover:bg-gray-500">Cancel</a>
  </div>
</div>